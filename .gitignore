# everything the pipeline produces: downloads, stems, shorts, edits, renders
workspace/

# environments and caches
.venv/
__pycache__/
*.pyc
node_modules/
.hyperframes/
.thumbnails/
.transcode-cache/
.waveform-cache/

# media is never source; the only exception is the library's bundled sfx
*.mp4
*.mov
*.webm
*.mkv
*.wav
*.mp3
*.m4a
*.jpg
*.png
!hypeedit/assets/sfx/*.mp3

# music tracks are local (licensing, size): put them in assets/music/
assets/music/*
!assets/music/README.md

# local settings and secrets
.claude/settings.local.json
.env
*.cookies.txt
cookies.txt
